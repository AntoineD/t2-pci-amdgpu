# 50-t2-stereo-speakers.conf — generated by t2-pci-amdgpu install.sh; do not edit.
#
# Installed only when the T2 audio card uses the 4-channel speaker layout
# (UCM AppleT2x4) and t2linux-audio has no speaker DSP profile for this model
# (iMac20,x).  The installer fills in the card's PCI address and the model.
#
# The 4 speaker channels, labelled FL FR RL RR, are two driver pairs in the
# same speakers, not front and rear.  Mixed straight into them, 5.1 puts the
# dialogue (FC) on one pair and the surround channels on the other, and stereo
# gets PipeWire's psd upmix: the second pair receives only L-R, delayed 12 ms.
# Voices then sound thin, hollow, or as if they come from one pair only.
#
# So a stereo "@MODEL@ Speakers" sink sits in front of the 4-channel one.
# Every stream is mixed to stereo first; the graph copies L to FL+RL and R to
# FR+RR.  WirePlumber creates it when the speaker sink appears and removes it
# with that sink, so selecting the headphones profile leaves no dead output.

node.software-dsp.rules = [
    {
        matches = [
            { node.name = "alsa_output.@T2_AUDIO_PCI@.HiFi__Speaker__sink" }
        ]
        actions = {
            create-filter = {
                # Not hidden: the raw sink's volume stays reachable.  It
                # should sit at 100%; the stereo sink's volume is the one to use.
                hide-parent = false
                filter-graph = {
                    node.description = "@MODEL@ Speakers"
                    media.name       = "@MODEL@ Speakers"
                    filter.graph = {
                        nodes = [
                            { type = builtin label = copy name = inL }
                            { type = builtin label = copy name = inR }
                            { type = builtin label = copy name = outFL }
                            { type = builtin label = copy name = outFR }
                            { type = builtin label = copy name = outRL }
                            { type = builtin label = copy name = outRR }
                        ]
                        links = [
                            { output = "inL:Out" input = "outFL:In" }
                            { output = "inL:Out" input = "outRL:In" }
                            { output = "inR:Out" input = "outFR:In" }
                            { output = "inR:Out" input = "outRR:In" }
                        ]
                        inputs  = [ "inL:In" "inR:In" ]
                        outputs = [ "outFL:Out" "outFR:Out" "outRL:Out" "outRR:Out" ]
                    }
                    capture.props = {
                        node.name        = "t2_stereo_speakers"
                        media.class      = "Audio/Sink"
                        audio.position   = [ FL FR ]
                        device.icon-name = "audio-speakers"
                        # Above the raw sink (1000): the default output when
                        # no saved choice names another one.
                        priority.session = 1500
                    }
                    playback.props = {
                        node.name          = "t2_stereo_speakers.output"
                        node.description   = "@MODEL@ Speakers (to raw speakers)"
                        target.object      = "alsa_output.@T2_AUDIO_PCI@.HiFi__Speaker__sink"
                        node.dont-fallback = true
                        node.passive       = true
                        audio.position     = [ FL FR RL RR ]
                    }
                }
            }
        }
    }
]

# Clearer names.  Only descriptions change: the filter finds the raw sink by
# node.name.  GNOME Settings labels these devices "<port> – <card>", so there
# the card name is what changes.
monitor.alsa.rules = [
    {
        matches = [ { device.name = "alsa_card.@T2_AUDIO_PCI@" } ]
        actions = { update-props = {
            device.description = "@MODEL@ Built-in Audio"
            device.nick        = "@MODEL@ Built-in Audio"
        } }
    }
    {
        matches = [ { node.name = "alsa_output.@T2_AUDIO_PCI@.HiFi__Speaker__sink" } ]
        actions = { update-props = {
            node.description = "Raw Speakers (do not use)"
            node.nick        = "Raw Speakers"
        } }
    }
    {
        matches = [ { node.name = "alsa_input.@T2_AUDIO_PCI@.HiFi__Mic__source" } ]
        actions = { update-props = {
            node.description = "@MODEL@ Microphone"
            node.nick        = "@MODEL@ Microphone"
        } }
    }
    {
        matches = [ { node.name = "alsa_input.@T2_AUDIO_PCI@.HiFi__Headset__source" } ]
        actions = { update-props = {
            node.description = "Headset Microphone (jack)"
            node.nick        = "Headset Microphone"
        } }
    }
]
