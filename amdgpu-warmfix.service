# /etc/systemd/system/amdgpu-warmfix.service
[Unit]
Description=AMDGPU Warmfix (PCIe reset/remove-rescan + late modprobe)
# The GPU PCI functions are enumerated by the kernel long before systemd, so
# this only needs udevd alive to process the events its rescan generates.
# systemd-udev-settle.service is deprecated and warns when pulled in; the
# generated reset script waits for the GPU's own sysfs node instead.
After=systemd-udevd.service
# Skip only when amdgpu will not probe: `nomodeset` with no amdgpu.modeset
# override.  amdgpu.modeset is "Override nomodeset (1 = enable, -1 = auto)";
# its only check is `drm_firmware_drivers_only() && amdgpu_modeset == -1`
# (amdgpu_drv.c, 7.2.8), so any value given, even 0, re-enables the probe, and
# amdgpu.modeset=0 alone disables nothing.  "|" conditions are OR-ed; a bare
# name matches it with any value.
ConditionKernelCommandLine=|!nomodeset
ConditionKernelCommandLine=|amdgpu.modeset
# ensure display manager starts after warmfix
Before=gdm.service display-manager.service graphical.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/amdgpu-pci-reset-load.sh
TimeoutStartSec=180
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

