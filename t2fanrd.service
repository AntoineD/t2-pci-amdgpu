# /etc/systemd/system/t2fanrd.service
[Unit]
Description=T2 fan daemon
After=systemd-modules-load.service applesmc-late.service

[Service]
Type=simple
# The T2 bridge module was renamed apple_bce -> t2bce_core in the 7.1 t2 kernel
# (drivers/staging/t2bce).  Try both names, and keep both tolerant with "-":
# a hard ExecStartPre failure fails the unit, Restart=always loops it forever,
# and the SMC silently keeps driving the fan on its own much louder curve.
# The real gate is the sysfs wait below, not these modprobes.
# -q: one name is always missing, and without it modprobe logs "FATAL: Module
# ... not found" every boot.  It still exits non-zero; "-" ignores that.
ExecStartPre=-/usr/sbin/modprobe -q t2bce_core
ExecStartPre=-/usr/sbin/modprobe -q apple_bce
ExecStartPre=-/usr/sbin/modprobe -q applesmc
# Wait for the exact attribute t2fanrd opens, not for the whole udev queue.
# On failure the unit fails and Restart=always retries in RestartSec.
ExecStartPre=/usr/local/bin/t2-wait-sysfs.sh -t 15 \
  '/sys/bus/acpi/devices/APP0001:*/fan1_manual' \
  '/sys/devices/platform/applesmc.*/fan1_manual'
# t2fanrd scans /sys automatically; no hardcoded path needed.
# No --config flag: the daemon has /etc/t2fand.conf (no "r") compiled in and
# ignores the flag entirely.  Passing it only creates the illusion that some
# other file is in use.
ExecStart=/usr/local/bin/t2fanrd
Restart=always
RestartSec=5
# Hand the fan back to the SMC when the service stops, so a dead daemon never
# leaves the machine pinned at a stale manual RPM.
# The old glob (/sys/devices/*/APP0001:*/) never matched: applesmc sits several
# levels deep under /sys/devices/LNXSYSTM:00/... and "*" spans one component
# only.  /sys/bus/acpi/devices/ is a flat, stable view of the same device.
ExecStopPost=/usr/bin/bash -c 'shopt -s nullglob; for f in /sys/bus/acpi/devices/APP0001:*/fan?_manual /sys/devices/platform/applesmc.*/fan?_manual; do echo 0 >"$f" || true; done; exit 0'

[Install]
WantedBy=multi-user.target
