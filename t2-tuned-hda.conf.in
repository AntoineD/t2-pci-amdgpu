# t2-pci-amdgpu: tuned HDA override — generated by install.sh, removed by uninstall.sh
#
# Shadows tuned's stock "@PROFILE@" profile with one change: keep the HDA
# controllers out of runtime suspend.  Everything else comes from the stock
# profile through the include below: tuned has already loaded this file, so
# it resolves the name to /usr/lib/tuned/profiles/@PROFILE@ instead.
#
# Why: amdgpu.conf sets snd_hda_intel power_save_controller=0, so the GPU's
# HDMI audio function (03:00.1 on iMac20,2) never runtime-suspends.  tuned's
# [audio] plugin defaults to reset_controller=true (tuned 2.28) and writes
# power_save_controller=Y when the profile loads, about 12 s into boot,
# undoing the module option.  Its "timeout" (codec power save) is unchanged.
#
# Profiles that include "@PROFILE@" (balanced-battery includes balanced) pick
# this file up too.

[main]
summary=@PROFILE@, with the HDA controllers kept awake (t2-pci-amdgpu)
include=@PROFILE@

[audio]
reset_controller=false
