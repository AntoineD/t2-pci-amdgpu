# 51-t2-mic.conf — generated by t2-pci-amdgpu install.sh; do not edit.
#
# Installed on the same Macs as 50-t2-stereo-speakers.conf: T2 audio card with
# the 4-channel speaker layout (UCM AppleT2x4) and no t2linux-audio DSP profile
# for the model (iMac20,x).  The installer fills in the card's PCI address and
# the model.
#
# The T2 hands over its microphones raw, with no capture gain control: speech
# arrives around -50 dBFS, ~40 dB below a usual microphone.  Under macOS,
# Apple's DSP adds the gain.  t2linux-audio does the same for each MacBook in
# its mic.json (beamformer, then +35..38 dB), but has none for the iMac, so
# apps (dictation, calls) get a level that voice detection takes for silence.
#
# The raw source has three channels, one per capsule.  AUX0 and AUX1 sit close
# together (correlation ~0.93 at 200-4000 Hz) and carry the voice; AUX1 also
# has a constant DC offset (~-43 dBFS).  AUX2 picks up a different signal
# (correlation ~-0.2), likely a capsule farther away: summed in without a
# beamformer it would comb-filter the voice, so it is left out.  It works,
# though, and a beamformer could use it.  Capture it with an explicit channel
# map (pw-record --channel-map AUX0,AUX1,AUX2): without one, parecord remixes
# the AUX channels to FL/FR/FC and the third comes back as all zeros.
#
# So a mono "@MODEL@ Microphone" source sits in front of the raw one: the mean
# of AUX0 and AUX1, +40 dB, a 90 Hz high-pass (removes the DC offset and room
# rumble) and a lookahead limiter at -1 dBFS, so a cough or a close voice does
# not clip.  On iMac20,2, dictated speech then peaked near -5 dBFS with ~22 dB
# between speech and room noise.  WirePlumber creates it when the raw source
# appears and removes it with that source.

node.software-dsp.rules = [
    {
        matches = [
            { node.name = "alsa_input.@T2_AUDIO_PCI@.HiFi__Mic__source" }
        ]
        actions = {
            create-filter = {
                # Not hidden: the raw source's volume stays reachable.  It
                # should sit at 100%; all the gain is in this filter.
                hide-parent = false
                filter-graph = {
                    node.description = "@MODEL@ Microphone"
                    media.name       = "@MODEL@ Microphone"
                    filter.graph = {
                        nodes = [
                            # Builtin gains are capped at 10 (+20 dB), so the
                            # gain takes two stages: (AUX0 + AUX1) * 5 = their
                            # mean +20 dB here, +20 dB more in the limiter.
                            { type = builtin label = mixer name = mix
                              control = { "Gain 1" = 5.0 "Gain 2" = 5.0 } }
                            { type = builtin label = bq_highpass name = hp
                              control = { "Freq" = 90.0 "Q" = 0.707 } }
                            # lv2-swh-plugins, a t2linux-audio dependency.
                            # ingain is its input gain (max +20 dB).
                            { type = lv2 name = lim
                              plugin = "http://plugin.org.uk/swh-plugins/fastLookaheadLimiter"
                              control = { "ingain" = 20.0 "limit" = -1.0 "release" = 0.25 } }
                        ]
                        links = [
                            { output = "mix:Out" input = "hp:In" }
                            { output = "hp:Out"  input = "lim:in_1" }
                        ]
                        inputs  = [ "mix:In 1" "mix:In 2" ]
                        outputs = [ "lim:out_1" ]
                    }
                    capture.props = {
                        node.name          = "t2_mic.capture"
                        node.description   = "@MODEL@ Microphone (from raw microphone)"
                        target.object      = "alsa_input.@T2_AUDIO_PCI@.HiFi__Mic__source"
                        audio.position     = [ AUX0 AUX1 ]
                        # Link AUX0/AUX1 by position; drop AUX2, never remix.
                        stream.dont-remix  = true
                        node.dont-fallback = true
                        # Lets the raw source suspend while nothing records.
                        node.passive       = true
                    }
                    playback.props = {
                        node.name        = "t2_mic"
                        media.class      = "Audio/Source"
                        audio.position   = [ MONO ]
                        device.icon-name = "audio-input-microphone"
                        # Above the raw source (1728): the default input when
                        # no saved choice names another one.
                        priority.session = 2000
                    }
                }
            }
        }
    }
]

monitor.alsa.rules = [
    {
        matches = [ { node.name = "alsa_input.@T2_AUDIO_PCI@.HiFi__Mic__source" } ]
        actions = { update-props = {
            node.description = "Raw Microphone (do not use)"
            node.nick        = "Raw Microphone"
        } }
    }
]
