# /etc/udev/rules.d/99-amdgpu-t2.rules
# Disable runtime power management on the AMD GPU functions immediately at
# device bind, before any driver claims the device.  PCIe runtime PM is a
# known source of GPU disappearance on Apple T2 hardware under Linux.

# AMD VGA function (PCI class 0x030000)
ACTION=="add", SUBSYSTEM=="pci", \
  ATTR{vendor}=="0x1002", ATTR{class}=="0x030000", \
  ATTR{power/control}="on"

# AMD HDMI audio function (PCI class 0x040300).
# Best-effort only: snd_hda_intel calls pm_runtime_allow() from its async probe
# work and resets this attribute to "auto" afterwards.  The rule still covers
# the window before the driver binds; the durable fix is
# `options snd_hda_intel power_save_controller=0` in /etc/modprobe.d/amdgpu.conf.
ACTION=="add", SUBSYSTEM=="pci", \
  ATTR{vendor}=="0x1002", ATTR{class}=="0x040300", \
  ATTR{power/control}="on"

# Pin AMD GPU dynamic power management to "low" to prevent thermal crashes.
# See https://wiki.t2linux.org/guides/hybrid-graphics/
SUBSYSTEM=="drm", DRIVERS=="amdgpu", \
  ATTR{device/power_dpm_force_performance_level}="low"

# Record that amdgpu's probe returned success, for the warmfix's settle wait.
# driver_bound() sends "bind" only after amdgpu_pci_probe() has returned 0, so
# this marks the true end of the probe.  udev's DRIVER= property cannot:
# really_probe() sets the driver before the probe runs, so any uevent during
# the probe carries DRIVER=amdgpu too.  Removing the device drops the record.
ACTION=="bind", SUBSYSTEM=="pci", DRIVER=="amdgpu", \
  ENV{AMDGPU_WARMFIX_BOUND}="1"
