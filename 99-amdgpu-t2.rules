# /etc/udev/rules.d/99-amdgpu-t2.rules
# Disable runtime power management on the AMD GPU functions immediately at
# device bind, before any driver claims the device.  PCIe runtime PM is a
# known source of GPU disappearance on Apple T2 hardware under Linux.

# AMD VGA function (PCI class 0x030000)
ACTION=="add", SUBSYSTEM=="pci", \
  ATTR{vendor}=="0x1002", ATTR{class}=="0x030000", \
  ATTR{power/control}="on"

# AMD HDMI audio function (PCI class 0x040300)
ACTION=="add", SUBSYSTEM=="pci", \
  ATTR{vendor}=="0x1002", ATTR{class}=="0x040300", \
  ATTR{power/control}="on"
