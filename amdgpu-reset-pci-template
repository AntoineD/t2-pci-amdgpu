# shellcheck shell=bash
# Stage 2: remove/rescan PCI functions
# NOTE: install.sh will replace ADDR with the slot root (e.g., "03:00").
#       The "0000:" domain prefix is kept literal here to stay stable across systems.

GPU_VGA="/sys/bus/pci/devices/0000:ADDR.0"

# This GPU's own render node, as a /dev path.  Never glob /dev/dri/renderD*:
# any other DRM driver (i915 on an iGPU-enabled MacBookPro, an eGPU) publishes
# there too, and would pass for "amdgpu came up" while this GPU stays dead.
gpu_render_node() {
  local n
  for n in "$GPU_VGA"/drm/renderD*; do
    [ -e "$n" ] && { echo "/dev/dri/${n##*/}"; return 0; }
  done
  return 1
}

# True if amdgpu itself is loaded and past its module init, i.e. the initial
# driver_register() probe of matching devices has run.  Built-in amdgpu has no
# initstate file.  While this is false a coldplug `modprobe amdgpu` can still
# be about to probe the device, so an unbound device proves nothing yet.
amdgpu_module_live() {
  [ -d /sys/module/amdgpu ] || return 1
  [ -e /sys/module/amdgpu/initstate ] || return 0
  [ "$(cat /sys/module/amdgpu/initstate)" = live ]
}

# True if the driver core has this device parked on its deferred-probe list.
# On T2 Macs that is the normal state of the cold probe until apple_gmux binds:
# amdgpu returns -EPROBE_DEFER from vga_switcheroo_client_probe_defer(), the
# device is unbound, and the probe re-runs from deferred_probe_work_func once
# gmux registers.  debugfs is the only place the list is visible; when it is
# not readable, fall back to the one precondition we know of — a gmux in ACPI
# (APP000B) with no driver bound to its PNP node.  Test the binding, not
# /sys/module/apple_gmux/initstate: a built-in gmux has no initstate file and
# would read as "deferred" forever, and a loaded gmux whose probe failed is
# "live" yet never registers the switcheroo handler amdgpu is waiting for.
amdgpu_probe_deferred() {
  local f=/sys/kernel/debug/devices_deferred gmux
  if [ -r "$f" ]; then
    grep -q "^${GPU_VGA##*/}[[:space:]]" "$f"
    return
  fi
  for gmux in /sys/bus/acpi/devices/APP000B:*; do
    [ -e "$gmux" ] || continue
    [ -e "$gmux/physical_node/driver" ] || return 0
  done
  return 1
}

# True once really_probe() for the VGA function has reached a terminal state:
#   DRM nodes published -> amdgpu_pci_probe() succeeded (see the caveat below)
#   no `driver` symlink, amdgpu live, not deferred -> failed and unbound, or
#                          amdgpu will never claim it
# The symlink itself is NOT a completion signal: driver_sysfs_add() creates it
# *before* really_probe() calls amdgpu_pci_probe(), so its presence only means
# "probe started".  Its absence is not one either: a probe that has not started
# yet (module still loading, or deferred) looks exactly like one that failed.
#
# Caveat: the nodes appear at drm_dev_register(), which is not the end of
# amdgpu_pci_probe() — xcp/kfd client/fbdev setup still follow and can fail,
# and the device lock is held throughout.  Nothing in sysfs marks the true end,
# so wait_amdgpu_settled() requires this to hold steadily before a remove,
# for less time once amdgpu_probe_ended() has seen an end signal.
amdgpu_probe_settled() {
  local n
  for n in "$GPU_VGA"/drm/card* "$GPU_VGA"/drm/renderD*; do
    [ -e "$n" ] && return 0
  done
  [ -e "$GPU_VGA/driver" ] && return 1
  amdgpu_module_live || return 1
  amdgpu_probe_deferred && return 1
  return 0
}

# True once the probe has sent one of its end signals, all outside sysfs.
# Sets probe_end to which one:
#   bound   udev has processed the "bind" uevent, which driver_bound() sends
#           only after amdgpu_pci_probe() returned 0; 99-amdgpu-t2.rules
#           records it as AMDGPU_WARMFIX_BOUND=1.  Not udev's DRIVER=: that
#           comes from dev->driver, which really_probe() sets before calling
#           the probe, so any uevent during the probe carries it too.
#   fbdev   the kernel logged "[drm] fbN: ... frame buffer device" for this
#           function.  amdgpu_pci_probe() sets up fbdev after every step that
#           can fail it; only debugfs (a failure is logged, not returned) and
#           runtime PM (off, runpm=0) follow before `return 0`.  It comes
#           sooner than the bind record (iMac20,2: line at 8.475s, bind seen
#           at 9.337s, udev being busy with amdgpu's child devices), and it
#           survives switch-root, which the bind record does not.
#   failed  the driver core logged "probe with driver amdgpu failed", which it
#           does once amdgpu_pci_probe() has returned.
# Kernel log lines count only if logged since the last `remove` (the
# baselines): the cold probe's lines are still in the buffer after a rescan.
# dmesg, not the journal: journald ingests the kernel log in bursts.  If the
# ring buffer has wrapped, a count stays at its baseline and the plain settle
# streak decides, as it did before these signals.
fail_baseline=0
fbdev_baseline=0
probe_end=""
probe_fail_count() {
  dmesg 2>/dev/null | grep -cF -- "${GPU_VGA##*/}: probe with driver amdgpu failed" || true
}
probe_fbdev_count() {
  dmesg 2>/dev/null | grep -F -- "${GPU_VGA##*/}: [drm] fb" \
    | grep -cF -- " frame buffer device" || true
}
amdgpu_probe_ended() {
  local props
  if [ -e "$GPU_VGA/driver" ]; then
    props=$(udevadm info -q property -p "$GPU_VGA" 2>/dev/null) || props=""
    if [[ $'\n'"$props"$'\n' == *$'\n'AMDGPU_WARMFIX_BOUND=1$'\n'* ]]; then
      probe_end=bound
    elif [ "$(probe_fbdev_count)" -gt "$fbdev_baseline" ]; then
      probe_end=fbdev
    else
      return 1
    fi
  else
    [ "$(probe_fail_count)" -gt "$fail_baseline" ] || return 1
    probe_end=failed
  fi
}

# Never issue a PCI remove while amdgpu_pci_probe() is in flight.  The write to
# `remove` blocks on the device lock the probe holds, then lands straight on the
# failing probe's cleanup path: amdgpu_driver_release_kms ->
# amdgpu_device_fini_sw -> vcn_v2_0_sw_fini tears down VCN sw state that the
# probe unwind already freed.  Measured on iMac20,2: "Oops: 0002" then "note:
# kworker/u64:2 exited with irqs disabled" — the boot wedges at the splash right
# after this script logs "remove ... (vga)" and never reaches "rescanning PCI
# bus".  The window is small (probe start to "[drm] Initialized amdgpu" is ~1.5s)
# but it is squarely where this unit starts: 3 of 4 consecutive boots lost it.
#
# A probe that never settles is not worth waiting out either.  If the probe
# worker oopses it dies holding the device lock, which is then never released.
# 7.2.9-310.t2 does this on every boot: its new iMac20,x DMI quirk table
# (imac5k_table, walked by amdgpu_discovery_set_ip_blocks) has no {}
# terminator, so dmi_check_system runs into the next object and faults in
# strcmp.  A `remove` write sleeps on that lock in D state
# forever: unkillable, so systemd's stop/kill timeouts run out one after
# another and the display manager waits ~7 minutes behind this unit.  So on
# timeout, return failure and let the caller skip the reset.  Probes normally
# settle within ~4s (success or SMU timeout); once the kernel carries the
# D (oops) taint, give up after 15s instead of 60s.
#
# "Settled" must hold for a run of consecutive polls, not one.  With no end
# signal the run is SETTLE_STABLE polls (~1.5s).  That covers the gap the
# single-shot test cannot see: a deferred device sits on neither list between
# deferred_probe_work_func() taking it off the active list and
# driver_sysfs_add(); and a probe that fails after drm_dev_register()
# unregisters its nodes on the way out, which breaks the streak.
#
# An end signal from amdgpu_probe_ended() cuts the run short.  The full run
# cost 1.5-2.0s on every boot (iMac20,2: failure logged at 10.6s, `remove` at
# 12.4s; probe done, fbdev up, at 8.5s, skip at 10.5s).
#   bound, fbdev
#           return at once: the probe has returned or can no longer fail,
#           and the skip that normally follows writes nothing.  A `remove`
#           (AMDGPU_WARMFIX_ALWAYS_RESET) waits on the device lock until the
#           probe returns, then unbinds a fully probed device.
#   failed  still SETTLE_STABLE_FAILED polls (~0.5s).  The line is logged
#           before really_probe() is done: driver_sysfs_remove() and the devres
#           teardown follow under the device lock, and amdgpu's "ttm finalized"
#           from that teardown landed 25ms after the line.  A `remove` in that
#           window is the crash described above.
SETTLE_STABLE=16
SETTLE_STABLE_FAILED=6
wait_amdgpu_settled() {
  local i limit=600 streak=0
  [ -e "$GPU_VGA" ] || return 0
  for i in $(seq 1 600); do
    if amdgpu_probe_settled; then
      streak=$(( streak + 1 ))
      if amdgpu_probe_ended \
         && { [ "$probe_end" != failed ] || [ "$streak" -ge "$SETTLE_STABLE_FAILED" ]; }; then
        log "amdgpu probe ended ($probe_end), settled after $(( i / 10 )).$(( i % 10 ))s"
        return 0
      fi
      if [ "$streak" -ge "$SETTLE_STABLE" ]; then
        log "amdgpu probe settled after $(( i / 10 )).$(( i % 10 ))s (no end signal seen)"
        return 0
      fi
    else
      streak=0
    fi
    if (( $(cat /proc/sys/kernel/tainted) & 128 )) && [ "$limit" -eq 600 ]; then
      limit=$(( i + 150 ))
    fi
    [ "$i" -ge "$limit" ] && break
    sleep 0.1
  done
  if ! amdgpu_module_live; then
    log "ERROR — amdgpu module not loaded after $(( i / 10 ))s; nothing for a reset to re-probe"
    return 1
  fi
  if amdgpu_probe_deferred; then
    log "ERROR — amdgpu probe of $GPU_VGA still deferred after $(( i / 10 ))s (apple_gmux not bound?)"
    return 1
  fi
  log "ERROR — amdgpu probe of $GPU_VGA never settled (after $(( i / 10 ))s)"
  if (( $(cat /proc/sys/kernel/tainted) & 128 )); then
    log "kernel is oops-tainted: probe worker likely died holding the device lock; check: journalctl -k -b | grep -B5 -A40 Oops"
  fi
  log "skipping PCI remove — the write would block forever on the device lock"
  return 1
}

# Callers must run wait_amdgpu_settled first.  It is not called here: on the
# first attempt the main flow has just done it, and a second call restarts the
# settle streak from zero for nothing.
#
# No sleep after each `remove`: the write returns only once
# pci_stop_and_remove_bus_device() has unbound the driver and deleted the
# device, so there is nothing left to wait for.  The 1s sleeps that used to
# follow cost 2s of display-manager start on every boot that needed a reset.
pci_remove_rescan() {
  # Probe lines logged from here on belong to the probe the rescan starts.
  fail_baseline=$(probe_fail_count)
  fbdev_baseline=$(probe_fbdev_count)
  for dev in /sys/bus/pci/devices/0000:ADDR.{1,0}; do
    if [ -e "$dev" ]; then
      if [[ "$dev" == *".1" ]]; then
        log "remove $dev (audio)"
      else
        log "remove $dev (vga)"
      fi
      echo 1 >"$dev/remove"
    fi
  done
  log "rescanning PCI bus"
  # Keep digits only: bash formats EPOCHREALTIME with the locale's decimal
  # point, which is a comma under e.g. LANG=fr_FR.UTF-8.
  rescan_start_us=${EPOCHREALTIME//[!0-9]/}
  echo 1 >/sys/bus/pci/rescan
}

# Polls every 0.2s for up to 20s.  The `rescan` write itself blocks while the
# new probe runs (~3.7s on iMac20,2), so the node is usually there on the first
# poll; time is therefore reported from the start of the rescan, not the poll.
wait_for_gpu() {
  local i node ms
  for i in $(seq 0 100); do
    if node=$(gpu_render_node); then
      ms=$(( (${EPOCHREALTIME//[!0-9]/} - rescan_start_us) / 1000 ))
      log "GPU ready $(( ms / 1000 )).$(( ms % 1000 / 100 ))s after rescan: $node"
      return 0
    fi
    sleep 0.2
  done
  return 1
}

# A cold probe that ran to completion needs no warmfix — remove/rescan on a
# healthy GPU just re-inits it (~6s) and re-opens the race above for no gain.
# The failure this unit exists to recover from is loud and detectable: SMU
# handshake times out, amdgpu_device_ip_init fails -62, and no DRM node is ever
# published.  Set AMDGPU_WARMFIX_ALWAYS_RESET=1 in the unit to reset regardless;
# any other value (0, false, empty) leaves the skip on.
skip_if_cold_probe_ok() {
  local node
  [ "${AMDGPU_WARMFIX_ALWAYS_RESET:-0}" = 1 ] && return 0
  node=$(gpu_render_node) || return 0
  log "cold probe already succeeded: $node — skipping remove/rescan"
  exit 0
}

# The unit no longer orders itself after systemd-udev-settle.service (deprecated,
# and a whole-queue barrier).  Wait for this GPU's own sysfs node instead — that
# is the only precondition Stage 2 actually has.  The node appearing only means
# the kernel enumerated the slot; waiting for amdgpu to be *done* with it is a
# separate concern, handled by wait_amdgpu_settled above.
if ! /usr/local/bin/t2-wait-sysfs.sh -t 10 "$GPU_VGA"; then
  log "WARNING — $GPU_VGA never appeared; skipping warmfix"
  exit 0
fi

# Let any in-flight or pending coldplug probe finish before deciding.  No skip
# check before this: a render node seen once only means drm_dev_register() ran,
# and the probe can still fail after it and unregister the node (see
# amdgpu_probe_settled).  Skipping on that sighting would leave the GPU dead
# with no reset.  On a healthy boot the fbdev line or the udev bind record
# ends the wait at once.
wait_amdgpu_settled || exit 1
skip_if_cold_probe_ok

log "Stage 2: PCI remove/rescan (attempt 1)"
pci_remove_rescan

if wait_for_gpu; then
  log "Stage 2: GPU initialized successfully"
else
  log "Stage 2: GPU not ready after first attempt — retrying"
  # The rescan above started a fresh probe; removing into *that* one crashes
  # exactly like removing into the cold one.
  wait_amdgpu_settled || exit 1
  pci_remove_rescan
  if wait_for_gpu; then
    log "Stage 2: GPU initialized on retry"
  else
    log "Stage 2: WARNING — GPU still not visible after retry; check dmesg"
  fi
fi
