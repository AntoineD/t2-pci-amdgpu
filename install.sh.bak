#!/usr/bin/env bash
# install.sh — Installer for AMDGPU warmfix (Fedora 42, iMac20,2 / Navi10, Apple T2)
#
# What this script does (no GRUB edits here):
#   1) Require root
#   2) (Optional) Build /boot/acpi_override.img from GFXALT-multi.aml if missing
#   3) Install *.service units to /etc/systemd/system (with backups)
#   4) Generate /usr/local/bin/amdgpu-pci-reset-load.sh from "amdgpu-reset-pci-template" (ADDR replacement)
#   5) Install other provided *.sh scripts to /usr/local/bin (except the template file)
#   6) Create a symlink-aware drop-in so the display manager starts AFTER warmfix
#   7) Add a small dracut config to include amdgpu/nvme/thunderbolt/pcieport (ask before replacing existing)
#   8) systemd daemon-reload, enable services, optional initramfs rebuild, optional immediate test
#
# Usage:
#   sudo ./install.sh      (run from the directory containing your files)
# Expected files in current directory (any subset is fine):
#   - amdgpu-reset-pci-template           (template fragment with placeholder ADDR)
#   - amdgpu-warmfix.service              (systemd unit to run warmfix at boot)
#   - GFXALT-multi.aml                    (optional ACPI table for override image)
#   - other helper scripts/services (e.g., t2-gpu-status.sh, t2fanrd.service, applesmc-late.service, ...)
#
#set -euo pipefail

if [[ "${DEBUG:-0}" = "1" ]]; then
  PS4='+ ${BASH_SOURCE##*/}:${LINENO}: '
  set -x
fi


say()  { printf "\033[1;36m==>\033[0m %s\n" "$*"; }
warn() { printf "\033[1;33m[!]\033[0m %s\n" "$*"; }
err()  { printf "\033[1;31m[✗]\033[0m %s\n" "$*" >&2; }
ask_yn(){ local p="${1:-Continue?} [Y/n] "; read -r -p "$p" a||true; case "${a:-Y}" in [Yy]*|"") return 0;; *) return 1;; esac; }
backup(){ [[ -e "$1" ]] || return 0; local ts; ts="$(date +%Y%m%d-%H%M%S)"; cp -a -- "$1" "$1.bak.$ts"; say "Backup created: $1.bak.$ts"; }

require_root(){ [[ $EUID -eq 0 ]] || { err "Run this script with sudo/root."; exit 1; }; }

# Paths
SRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="/usr/local/bin"
UNIT_DIR="/etc/systemd/system"
DRACUT_DIR="/etc/dracut.conf.d"
DRACUT_CONF="${DRACUT_DIR}/10-amdgpu-warmfix.conf"
ACPI_IMG="/boot/acpi_override.img"
ACPI_SRC="${SRC_DIR}/GFXALT-multi.aml"

require_root
say "Starting amdgpu warmfix installation"

# 0) ACPI override image (optional, skip if already present or no AML provided)
if [[ -f "$ACPI_IMG" ]]; then
  say "acpi_override.img already present in /boot — skipping creation."
elif [[ -f "$ACPI_SRC" ]]; then
  say "Creating /boot/acpi_override.img from GFXALT-multi.aml"
  tmpdir="$(mktemp -d)"
  mkdir -p "$tmpdir/kernel/firmware/acpi"
  cp "$ACPI_SRC" "$tmpdir/kernel/firmware/acpi/"
  ( cd "$tmpdir" && find kernel | cpio -H newc --quiet -o | gzip > acpi_override.img )
  cp "$tmpdir/acpi_override.img" "$ACPI_IMG"
  rm -rf "$tmpdir"
  say "Installed ACPI override image: $ACPI_IMG"
else
  warn "No ACPI override created (missing $ACPI_SRC) — this is optional."
fi

# 1) Install *.service units (backup if exist)
shopt -s nullglob
say "Installing systemd units"
found_service=0
for f in "${SRC_DIR}"/*.service; do
  found_service=1
  dst="${UNIT_DIR}/$(basename "$f")"
  backup "$dst"
  install -Dm0644 "$f" "$dst"
  say "Installed service: $dst"
done
if (( ! found_service )); then
  warn "No *.service files found in current directory (ok if already installed)."
fi

# 2) Generate /usr/local/bin/amdgpu-pci-reset-load.sh from template (ADDR replacement)
TEMPLATE="${SRC_DIR}/amdgpu-reset-pci-template"
TARGET="${BIN_DIR}/amdgpu-pci-reset-load.sh"

if [[ -f "$TEMPLATE" ]]; then
  say "Generating amdgpu-pci-reset-load.sh from template (ADDR replacement)"
  # Prefer lspci for discovery; fallback to sysfs-only if lspci missing.
  gpu_bdf="$(lspci -D -nn 2>/dev/null | awk '/VGA compatible controller/ && /\[1002:/{print $1; exit}')"
  if [[ -z "${gpu_bdf:-}" ]]; then
    # sysfs fallback: AMD vendor 0x1002 + VGA class 0x0300*
    gpu_bdf="$(for d in /sys/bus/pci/devices/*; do \
                 [[ -e "$d/vendor" && -e "$d/class" ]] || continue; \
                 read -r ven < "$d/vendor"; read -r cls < "$d/class"; \
                 if [[ "$ven" == "0x1002" && "$cls" == 0x0300* ]]; then basename "$d"; break; fi; \
               done)"
  fi
  if [[ -z "${gpu_bdf:-}" ]]; then
    err "Could not detect AMD VGA device (neither lspci nor sysfs fallback worked)."
    exit 1
  fi
  slot_root="${gpu_bdf%.*}"                # e.g., 0000:03:00
  slot_root="${slot_root#0000:}"           # template keeps the '0000:' prefix literal
  # Build final script: header + template body with ADDR replaced
  backup "$TARGET"
  {
    cat <<'HDR'
#!/usr/bin/env bash
# amdgpu-pci-reset-load.sh — PCI remove/rescan helper for AMD GPU (audio first)
set -euo pipefail
log(){ echo "[amdgpu-warmfix] $*"; }
HDR
    sed "s/ADDR/${slot_root}/g" "$TEMPLATE"
  } > "$TARGET"
  chmod 0755 "$TARGET"
  say "Installed script: $TARGET (slot root: ${slot_root})"
else
  warn "Template not found: $TEMPLATE — skipping generation of amdgpu-pci-reset-load.sh"
fi

# 3) Install other *.sh scripts to /usr/local/bin (except any file named exactly 'amdgpu-reset-pci-template')
for f in "${SRC_DIR}"/*.sh; do
  [[ -f "$f" ]] || continue
  base="$(basename "$f")"
  if [[ "$base" == "amdgpu-reset-pci-template" ]]; then
    continue
  fi
  dst="${BIN_DIR}/${base}"
  backup "$dst"
  install -Dm0755 "$f" "$dst"
  say "Installed script: $dst"
done

# 4) systemd: daemon-reload + enable services
say "Reloading systemd units"
systemctl daemon-reload

enable_if_present() {
  local unit="$1"
  if [[ -f "${UNIT_DIR}/${unit}" ]]; then
    systemctl enable "$unit"
    say "Enabled $unit"
  fi
}

enable_if_present "amdgpu-warmfix.service"
enable_if_present "t2fanrd.service"
enable_if_present "applesmc-late.service"

# 5) Display manager drop-in (symlink-aware), ensure it starts AFTER warmfix
say "Configuring display-manager drop-in (symlink-aware)"
dm_unit="/etc/systemd/system/display-manager.service"
if [[ -L "$dm_unit" ]]; then
  real_unit="$(realpath "$dm_unit")"
  real_name="$(basename "$real_unit")"
  drop_dir="/etc/systemd/system/${real_name}.d"
else
  drop_dir="/etc/systemd/system/display-manager.service.d"
fi
mkdir -p "$drop_dir"
drop_file="${drop_dir}/10-amdgpu-warmfix.conf"
backup "$drop_file"
cat > "$drop_file" <<'EOF'
[Unit]
After=amdgpu-warmfix.service
Wants=amdgpu-warmfix.service
EOF
chmod 0644 "$drop_file"
systemctl daemon-reload
say "Drop-in installed: ${drop_file}"

# 6) Dracut config (include required drivers); confirm before replacing existing
say "Configuring dracut to include amdgpu/nvme/thunderbolt/pcieport"
mkdir -p "$DRACUT_DIR"
if [[ -f "$DRACUT_CONF" ]]; then
  warn "Dracut config already exists: $DRACUT_CONF"
  if ask_yn "Replace it with the recommended version?"; then
    backup "$DRACUT_CONF"
    cat > "$DRACUT_CONF" <<'EOF'
# 10-amdgpu-warmfix.conf
add_drivers+=" amdgpu nvme thunderbolt pcieport "
EOF
    chmod 0644 "$DRACUT_CONF"
  else
    say "Keeping existing dracut config"
  fi
else
  cat > "$DRACUT_CONF" <<'EOF'
# 10-amdgpu-warmfix.conf
add_drivers+=" amdgpu nvme thunderbolt pcieport "
EOF
  chmod 0644 "$DRACUT_CONF"
fi

# 7) Optional: rebuild initramfs
if ask_yn "Rebuild initramfs for current kernel ($(uname -r))?"; then
  say "Running: dracut -f --kver $(uname -r)"
  dracut -f --kver "$(uname -r)"
fi

# 8) Optional: immediate test
if ask_yn "Start amdgpu-warmfix.service now for testing?"; then
  systemctl start amdgpu-warmfix.service || warn "Service failed to start, check journal."
  say "Recent journal entries:"
  journalctl -u amdgpu-warmfix.service -n 60 --no-pager || true
fi

say "✅ Installation finished."
echo "At next boot: acpi_override (if created) and amdgpu-warmfix will run before the display manager."
